<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF" android:padding="16dp"
    tools:context=".AnaEkran.MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/four_sections_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_bolum1"
                    android:layout_width="0dp"
                    android:layout_height="250dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    card_view:cardBackgroundColor="#FFFFFF" card_view:cardCornerRadius="20dp"
                    card_view:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_weight="1"
                            android:scaleType="centerCrop"
                            android:src="@drawable/kalpbolumu"
                            android:theme="@style/Theme.arkaplanbos" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            android:text="1. Merdiven"
                            android:textColor="#333333" android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/alt_bolum1aa"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/bolumler_buton_selector"
                            android:elevation="12dp"
                            android:onClick="altBolum_tiklaaa"
                            android:src="@android:drawable/ic_media_play"
                            card_view:tint="@color/white"
                            tools:ignore="OnClick" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_bolum2"
                    android:layout_width="0dp"
                    android:layout_height="250dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    card_view:cardBackgroundColor="#FFFFFF"
                    card_view:cardCornerRadius="20dp"
                    card_view:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_weight="1"
                            android:scaleType="centerCrop"
                            android:src="@drawable/akilbolumu"
                            android:theme="@style/Theme.arkaplanbos" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            android:text="2. Merdiven"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/alt_bolum1ab"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/bolumler_buton_selector"
                            android:elevation="12dp"
                            android:onClick="altBolum_tiklaaa"
                            android:src="@android:drawable/ic_media_play"
                            card_view:tint="@color/white"
                            tools:ignore="OnClick" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_bolum3"
                    android:layout_width="0dp"
                    android:layout_height="250dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    card_view:cardBackgroundColor="#FFFFFF"
                    card_view:cardCornerRadius="20dp"
                    card_view:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_weight="1"
                            android:padding="30dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/nefisbolumu"
                            android:theme="@style/Theme.arkaplanbos" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            android:text="3. Merdiven"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/alt_bolum1ac"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/bolumler_buton_selector"
                            android:elevation="12dp"
                            android:onClick="altBolum_tiklaaa"
                            android:src="@android:drawable/ic_media_play"
                            card_view:tint="@color/white"
                            tools:ignore="OnClick" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_bolum4"
                    android:layout_width="0dp"
                    android:layout_height="250dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    card_view:cardBackgroundColor="#FFFFFF"
                    card_view:cardCornerRadius="20dp"
                    card_view:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_weight="1"
                            android:scaleType="centerCrop"
                            android:src="@drawable/kamilbolumu"
                            android:theme="@style/Theme.arkaplanbos" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            android:text="4. Merdiven"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/alt_bolum1ad"
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="5dp"
                            android:background="@drawable/bolumler_buton_selector"
                            android:elevation="12dp"
                            android:onClick="altBolum_tiklaaa"
                            android:src="@android:drawable/ic_media_play"
                            card_view:tint="@color/white"
                            tools:ignore="OnClick" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>