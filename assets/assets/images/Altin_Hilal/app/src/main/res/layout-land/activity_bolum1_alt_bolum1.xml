                            android:paddingTop="20dp"
                            android:rotation="-20"
                            android:text="COMPLETED"
                            android:textColor="#FF0000"
                            android:textSize="20dp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!--  Level 3 (Sol) -->
