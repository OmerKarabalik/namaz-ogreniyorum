                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal"> <!-- Bu satır ile tüm içeriği sağa yaslayabilirsiniz -->

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="45dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ok_resim"
                    android:theme="@style/Theme.arkaplanbos" />

                <androidx.cardview.widget.CardView
                    android:layout_width="150dp"
                    android:layout_height="120dp"
                    android:layout_gravity="end"
                    android:padding="20dp"
                    card_view:cardBackgroundColor="@color/cardview_light_background"
                    card_view:cardCornerRadius="50dp"
                    card_view:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="50dp"
                            android:layout_gravity="center"
                            android:padding="5dp"
                            android:src="@drawable/bolumler_1"
                            android:theme="@style/Theme.arkaplanbos" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="2dp"
                            android:text="Level 2"
                            android:textColor="@color/Black"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/alt_bolum2"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bolumler_buton_selector"
                            android:elevation="12dp"
                            android:onClick="altBolum_tikla_Bolum1"
                            android:src="@android:drawable/ic_media_play" />
                    </LinearLayout>

                    <LinearLayout
