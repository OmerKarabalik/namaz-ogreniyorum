                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/bolumler_buton_selector"
                            android:elevation="12dp"
                            android:onClick="altBolum_tikla_Bolum1"
