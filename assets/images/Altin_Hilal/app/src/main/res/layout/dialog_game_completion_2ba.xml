<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="@android:color/white"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/imgCompletionIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/baseline_check_circle_24"
            android:layout_marginBottom="16dp"
            android:contentDescription="Başarı İkonu"
            app:tint="@color/Orchid" />

        <TextView
            android:id="@+id/tvCompletionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="26sp"
            android:textColor="@color/Orchid"
            android:layout_marginBottom="8dp"
            android:text="Tebrikler!" />

        <TextView
            android:id="@+id/tvCompletionMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:textAlignment="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp"
            android:text="Harikasın! Tüm kelimeleri başarıyla tamamladın!" />

    </LinearLayout>
</androidx.cardview.widget.CardView>