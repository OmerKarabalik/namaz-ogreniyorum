<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/WhiteSmoke"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/top_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/dogru_yanlis"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/cerceve_b2_altb"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <LinearLayout
                    android:id="@+id/dogrulinearlayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/dogru_bolum2"
                        android:layout_width="30dp"
                        android:layout_height="50dp"
                        android:layout_margin="5dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/true_icon" />

                    <TextView
                        android:id="@+id/ilerleme_tv_bolum2"
                        android:layout_width="30dp"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="0"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="#059669"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/can_icons"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="3dp"
                        android:text="Lives :  "
                        android:textColor="#1F2937"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/can_icon1"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_margin="2dp"
                        android:src="@drawable/can" />

                    <ImageView
                        android:id="@+id/can_icon2"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_margin="2dp"
                        android:src="@drawable/can" />

                    <ImageView
                        android:id="@+id/can_icon3"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_margin="2dp"
                        android:src="@drawable/can" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <LinearLayout
                    android:id="@+id/yanlislinearlayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/yanlis_bolum2"
                        android:layout_width="30dp"
                        android:layout_height="50dp"
                        android:layout_margin="5dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/false_icon" />

                    <TextView
                        android:id="@+id/ilerleme_tv_yan_bolum2"
                        android:layout_width="30dp"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="0"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="#059669"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/score_linearlayout"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/kupa_score"
                        android:layout_width="70dp"
                        android:layout_height="50dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center"
                        android:text="Scor :"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="#DB2777"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/skore_puan"
                        android:layout_width="40dp"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="15dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center"
                        android:text="0"
                        android:textAppearance="?android:attr/textAppearanceLarge"
                        android:textColor="#DB2777"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/wordContainer"
        app:alignItems="center"
        app:flexWrap="wrap"
        app:justifyContent="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_section"
        android:layout_marginTop="16dp" />
    />

    <TextView
        android:id="@+id/sentenceTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/wordContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/sentence_bg"
        android:padding="8dp"
        android:gravity="center"
        android:text="Sentence to Guess:"
        android:textColor="#C026D3"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/keyboardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/sentenceTextView"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonQ"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="Q" />
            <Button
                android:id="@+id/buttonW"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="W" />

            <Button
                android:id="@+id/buttonE"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="E" />

            <Button
                android:id="@+id/buttonR"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="R" />

            <Button
                android:id="@+id/buttonT"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="T" />

            <Button
                android:id="@+id/buttonY"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="Y" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonA"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="A" />

            <Button
                android:id="@+id/buttonS"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="S" />

            <Button
                android:id="@+id/buttonD"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="D" />

            <Button
                android:id="@+id/buttonF"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="F" />

            <Button
                android:id="@+id/buttonG"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="G" />

            <Button
                android:id="@+id/buttonH"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="H" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonZ"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="Z" />

            <Button
                android:id="@+id/buttonX"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="X" />

            <Button
                android:id="@+id/buttonC"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="C" />

            <Button
                android:id="@+id/buttonV"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="V" />

            <Button
                android:id="@+id/buttonB"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="B" />

            <Button
                android:id="@+id/buttonN"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="N" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonU"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="U" />

            <Button
                android:id="@+id/buttonI"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="I" />

            <Button
                android:id="@+id/buttonO"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="O" />

            <Button
                android:id="@+id/buttonP"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="P" />

            <Button
                android:id="@+id/buttonĞ"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="Ğ" />

            <Button
                android:id="@+id/buttonÜ"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="Ü" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonJ"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="J" />

            <Button
                android:id="@+id/buttonK"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="K" />

            <Button
                android:id="@+id/buttonL"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="L" />

            <Button
                android:id="@+id/buttonŞ"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="Ş" />

            <Button
                android:id="@+id/buttonİ"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="İ" />

            <Button
                android:id="@+id/buttonM"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="M" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonÖ"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="Ö" />

            <Button
                android:id="@+id/buttonÇ"
                style="@style/keyboardButton"
                android:onClick="guessLetter"
                android:text="Ç" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/keyboardContainer"
        android:padding="8dp">

    </TextView>

    <LinearLayout
        android:id="@+id/AboutLinear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="8dp"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/spinner_with_icon_b2a"
                android:paddingHorizontal="8dp"
                android:spinnerMode="dropdown" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/GameAbout1c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F0FDF4"
                android:padding="12dp"
                android:text="About the Game"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnInfob3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Game info"
                android:src="@drawable/baseline_info_24" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>