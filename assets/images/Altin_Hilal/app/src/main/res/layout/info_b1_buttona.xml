<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_margin="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/LightBlue">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📢 Oyun Hakkında"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/Orchid" />

    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:layout_marginTop="10dp"
        android:text="🎯 Amaç: Soldaki kelimeler ile sağdaki anlamlarını eşleştir.\n\n🧠 Doğru eşleşmede butonlar kaybolur.\n\n🎮 Tüm eşleşmeler tamamlandığında yeni bölüme geçilir." />
</LinearLayout>
