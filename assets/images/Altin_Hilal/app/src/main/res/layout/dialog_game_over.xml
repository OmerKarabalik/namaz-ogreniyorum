<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/tvGameOverTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="Oyun Bitti!"
            android:textColor="#D32F2F"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGameOverMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="26dp"
            android:lineSpacingExtra="4dp"
            android:text="Maalesef, bu kelimeyi tahmin edemedin. Tüm can hakların tükendi."
            android:textAlignment="center"
            android:textColor="@android:color/black"
            android:textSize="18sp" />

        <!-- MODERN TEKRAR OYNA BUTONU -->
        <Button
            android:id="@+id/btnPlayAgain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/btn_primary_2ba"
            android:elevation="6dp"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:text="Tekrar Dene"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="20sp" />

        <!-- MODERN ÇIKIŞ BUTONU -->
        <Button
            android:id="@+id/btnExitikie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_secondary_2ba"
            android:elevation="4dp"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:text="Çıkış"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:textSize="20sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
