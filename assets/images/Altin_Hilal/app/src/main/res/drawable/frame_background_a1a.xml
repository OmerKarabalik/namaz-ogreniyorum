<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dış Kenar Gölgesi -->
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/> <!-- Dış kenar yuvarlama -->
            <solid android:color="@android:color/darker_gray"/> <!-- Gölge rengi -->
        </shape>
    </item>

    <!-- Ana Arka Plan -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/> <!-- İç kenar yuvarlama -->
            <solid android:color="@color/LightGrey"/> <!-- İç arka plan rengi -->
            <stroke
                android:width="3dp"
                android:color="@color/black"/> <!-- Kenar çerçevesi rengi -->
        </shape>
    </item>
</layer-list>
