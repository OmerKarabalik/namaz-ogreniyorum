default_platform(:ios)

platform :ios do
  desc "Build and upload iOS App to App Store Connect / TestFlight"
  lane :release_to_app_store do
    # 1. Connect via App Store Connect API
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    # 2. Create temporary CI Keychain
    keychain_name = "ci_keychain"
    keychain_password = "ci_keychain_password"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    db_path = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    raw_path = File.expand_path("~/Library/Keychains/#{keychain_name}")
    keychain_file = File.exist?(db_path) ? db_path : raw_path

    # 3. Fetch or generate iOS Distribution Certificate
    get_certificates(
      api_key: api_key,
      keychain_path: keychain_file,
      keychain_password: keychain_password
    )

    # 4. Fetch or generate App Store Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.omrkr.namaz.ogreniyorum.app"
    )

    profile_name = ENV["sigh_com.omrkr.namaz.ogreniyorum.app_app-store_profile-name"]
    UI.message("Using Provisioning Profile: #{profile_name}")

    # 5. Build signed release IPA
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      output_name: "NamazOgreniyorum.ipa",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: {
          "com.omrkr.namaz.ogreniyorum.app" => profile_name
        }
      }
    )

    # 6. Upload directly to TestFlight & App Store
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false
    )
  end
end
